{:paths ["src"]

 :deps {org.clojure/clojure              {:mvn/version "1.12.0"}

        ;; JLine for terminal I/O
        org.jline/jline-terminal          {:mvn/version "3.27.1"}

        ;; Markdown parsing + Clojure syntax highlighting
        io.github.nextjournal/markdown    {:mvn/version "0.7.222"}
        venantius/glow                    {:mvn/version "0.1.6"}

        ;; Spindel for reactive signals (used by tui.clj runner)
        org.replikativ/spindel            {:git/url "https://github.com/replikativ/spindel"
                                           :git/sha "7bcb49d5e6a0e633f93c8e58bf90e8a6574ca94b"}}

 :aliases
 {:dev  {:extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}}}

  :demo {:main-opts ["-m" "org.replikativ.spindel-tui.demo"]}}}
