{:paths ["src"]

 :deps {org.clojure/clojure              {:mvn/version "1.12.0"}

        ;; JLine for terminal I/O
        org.jline/jline-terminal          {:mvn/version "3.27.1"}

        ;; Markdown parsing + Clojure syntax highlighting
        io.github.nextjournal/markdown    {:mvn/version "0.7.222"}
        venantius/glow                    {:mvn/version "0.1.6"}

        ;; Spindel for reactive signals (used by tui.clj runner) — released coord,
        ;; same version dvergr pins, so a published spindel-tui jar resolves it.
        org.replikativ/spindel            {:mvn/version "0.1.28"}}

 :aliases
 {:dev  {:extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}}}

  :demo {:main-opts ["-m" "org.replikativ.spindel-tui.demo"]}

  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "cognitect.test-runner"]
         :exec-fn     cognitect.test-runner.api/test}

  ;; Build / release (Clojars + GitHub) — mirrors the replikativ template.
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.6"}
                 slipset/deps-deploy {:mvn/version "0.2.2"}
                 io.github.borkdude/gh-release-artifact {:git/sha "b946558225a7839f6a0f644834e838e190dc2262"}}
          :ns-default build}}}
